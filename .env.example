# Google Gemini API key (free tier) — used for the agent's generation and
# tool-calling loop. Get one at aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Where Chroma persists its local vector DB
CHROMA_PERSIST_DIR=./data/processed/chroma

# Where the BM25 index and memory tracker store their state
BM25_INDEX_PATH=./data/processed/bm25_index.pkl
MEMORY_DB_PATH=./data/processed/memory.json

# Embedding model (runs locally, no API cost)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
